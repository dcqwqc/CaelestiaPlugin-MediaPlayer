#!/usr/bin/env python3
import json, os, re, subprocess, sys
from pathlib import Path

STATE=Path(os.environ.get('XDG_RUNTIME_DIR',f'/run/user/{os.getuid()}'))/'caelestia-premium-media-chrome.json'

def rgb(v):
    v=v.strip().lstrip('#')
    if len(v)==8: v=v[-6:]
    if not re.fullmatch(r'[0-9a-fA-F]{6}',v): raise ValueError(v)
    return v.lower()

def call(*a):
    return subprocess.run(a,text=True,capture_output=True,check=False)

def keyword(key,value):
    subprocess.run(['hyprctl','keyword',key,value],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=False)

def supported(*keys):
    for key in keys:
        if call('hyprctl','getoption',key).returncode==0: return key
    return keys[0]

def current(key):
    p=call('hyprctl','getoption','-j',key)
    if p.returncode: return None
    try: return json.loads(p.stdout).get('gradient','').split()[0] or None
    except Exception: return None

def save_once(keys):
    if STATE.exists(): return
    state={k:current(k) for k in keys}
    STATE.write_text(json.dumps(state))

def restore():
    if not STATE.exists(): return 0
    try: state=json.loads(STATE.read_text())
    except Exception: state={}
    for key,value in state.items():
        if value: keyword(key,'0x'+value)
    try: STATE.unlink()
    except OSError: pass
    return 0

def main():
    if len(sys.argv)<2: return 2
    if not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'): return 0
    if sys.argv[1]=='restore': return restore()
    if sys.argv[1]!='apply' or len(sys.argv)!=6: return 2
    active,inactive,shadow=map(rgb,sys.argv[2:5])
    opacity=max(0,min(100,int(sys.argv[5]))); alpha=round(255*opacity/100)
    sk=supported('decoration:shadow:color','decoration:col.shadow')
    sik=supported('decoration:shadow:color_inactive','decoration:col.shadow_inactive')
    keys=['general:col.active_border','general:col.inactive_border',sk,sik]
    save_once(keys)
    keyword(keys[0],f'rgba({active}ee)'); keyword(keys[1],f'rgba({inactive}61)')
    keyword(sk,f'rgba({shadow}{alpha:02x})'); keyword(sik,f'rgba({shadow}{max(0,alpha//2):02x})')
    return 0

if __name__=='__main__': raise SystemExit(main())
