#!/usr/bin/env python3
import os, re, subprocess, sys

def rgb(v):
    v=v.strip().lstrip('#')
    if len(v)==8: v=v[-6:]
    if not re.fullmatch(r'[0-9a-fA-F]{6}',v): raise ValueError(v)
    return v.lower()

def run(*a):
    subprocess.run(a, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def supported(*keys):
    for k in keys:
        if subprocess.run(['hyprctl','getoption',k],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0:
            return k
    return keys[0]

def main():
    if len(sys.argv)<2: return 2
    if sys.argv[1]=='restore':
        if os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'): run('hyprctl','reload')
        return 0
    if sys.argv[1]!='apply' or len(sys.argv)!=6: return 2
    if not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'): return 0
    active,inactive,shadow=map(rgb,sys.argv[2:5])
    opacity=max(0,min(100,int(sys.argv[5])))
    alpha=round(255*opacity/100)
    shadow_key=supported('decoration:shadow:color','decoration:col.shadow')
    inactive_shadow_key=supported('decoration:shadow:color_inactive','decoration:col.shadow_inactive')
    run('hyprctl','keyword','general:col.active_border',f'rgba({active}ee)')
    run('hyprctl','keyword','general:col.inactive_border',f'rgba({inactive}61)')
    run('hyprctl','keyword',shadow_key,f'rgba({shadow}{alpha:02x})')
    run('hyprctl','keyword',inactive_shadow_key,f'rgba({shadow}{max(0,alpha//2):02x})')
    return 0

if __name__=='__main__': raise SystemExit(main())
