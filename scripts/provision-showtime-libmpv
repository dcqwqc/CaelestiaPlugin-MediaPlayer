#!/usr/bin/env python3
"""Offline, nonroot runtime snapshot from installed Showtime and signed python-mpv.

No downloads, package installation, loader paths, settings or desktop changes.
Source files must come from a locally installed, trusted Flatpak deployment.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import tarfile
import tempfile


def provision(args):
    if args.destination.exists():
        raise RuntimeError('Destination exists; choose a new versioned directory')
    # Verify against the system distributor keyring; a key supplied beside the
    # package is not a trust anchor. gpgv does not fetch keys or change trust.
    subprocess.run(['gpgv', '--keyring', str(args.keyring.resolve()),
                    str(args.signature.resolve()), str(args.mpv_package.resolve())],
                   check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    location = Path(subprocess.check_output(
        ['flatpak', 'info', '--show-location', 'org.gnome.Showtime'], text=True).strip())
    commit = subprocess.check_output(
        ['flatpak', 'info', '--show-commit', 'org.gnome.Showtime'], text=True).strip()
    source = location / 'files'
    package = source / 'share/showtime'
    init = (package / 'showtime/__init__.py').read_text()
    if not ('VERSION = "50.0"' in init or "VERSION = '50.0'" in init):
        raise RuntimeError('Requires installed GNOME Showtime 50.0')
    args.destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='.showtime-stage-', dir=args.destination.parent) as temp:
        stage = Path(temp)
        shutil.copytree(package, stage / 'share/showtime', ignore=shutil.ignore_patterns('__pycache__', '*.pyc'))
        (stage / 'schemas').mkdir()
        schemas = list((source / 'share/glib-2.0/schemas').glob('org.gnome.Showtime*.gschema.xml'))
        if not schemas: raise RuntimeError('Showtime schemas missing')
        for schema in schemas: shutil.copyfile(schema, stage / 'schemas' / schema.name)
        subprocess.run(['glib-compile-schemas', '--strict', str(stage / 'schemas')], check=True)
        # Extract precisely one pure Python module. Never unpack arbitrary
        # archive paths, links, native libraries, install hooks or executables.
        with tarfile.open(args.mpv_package) as archive:
            matches = [m for m in archive if m.isfile() and m.name.endswith('/site-packages/mpv.py')]
            if len(matches) != 1 or matches[0].size > 2_000_000:
                raise RuntimeError('Unexpected python-mpv package layout')
            (stage / 'python').mkdir()
            (stage / 'python/mpv.py').write_bytes(archive.extractfile(matches[0]).read())
        files = {str(p.relative_to(stage)): hashlib.sha256(p.read_bytes()).hexdigest()
                 for p in stage.rglob('*') if p.is_file()}
        manifest = {'format': 1, 'showtime_version': '50.0', 'flatpak_commit': commit,
                    'mpv_package_sha256': hashlib.sha256(args.mpv_package.read_bytes()).hexdigest(),
                    'files': files}
        (stage / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
        # Atomic publish with no overwrite. Parent is user-owned; no root.
        os.rename(stage, args.destination)
    print(f'Runtime prepared: {args.destination}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--mpv-package', type=Path, required=True)
    parser.add_argument('--signature', type=Path, required=True)
    parser.add_argument('--keyring', type=Path, default=Path('/usr/share/pacman/keyrings/archlinux.gpg'))
    parser.add_argument('--destination', type=Path, required=True)
    args = parser.parse_args()
    if os.geteuid() == 0: parser.error('Run as the desktop user, never root')
    try: provision(args)
    except Exception as exc:
        parser.exit(1, f'Runtime provisioning failed: {type(exc).__name__}\n')


if __name__ == '__main__': main()
