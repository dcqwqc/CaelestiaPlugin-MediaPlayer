#!/usr/bin/env bash
set -euo pipefail
video="${1:?video URL required}"
referrer="${2:-https://zokoanime.video/}"
subtitle="${3:-}"
title="${4:-Anime}"

# Remote/agent shells may not inherit the graphical session environment.
# Recover it from the running Caelestia shell so Showtime can still launch.
if [[ -z "${WAYLAND_DISPLAY:-}" || -z "${DBUS_SESSION_BUS_ADDRESS:-}" || -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  shell_pid="$(systemctl --user show -p MainPID --value caelestia-shell.service 2>/dev/null || true)"
  if [[ -n "$shell_pid" && "$shell_pid" != "0" && -r "/proc/$shell_pid/environ" ]]; then
    while IFS= read -r -d '' kv; do
      case "$kv" in
        WAYLAND_DISPLAY=*|HYPRLAND_INSTANCE_SIGNATURE=*|DBUS_SESSION_BUS_ADDRESS=*|XDG_RUNTIME_DIR=*) export "$kv" ;;
      esac
    done < "/proc/$shell_pid/environ"
  fi
fi
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$UID}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
port="$(python3 - <<'PY'
import socket
s=socket.socket(); s.bind(('127.0.0.1',0)); print(s.getsockname()[1]); s.close()
PY
)"
# Keep one clean Showtime playback instance per ani-cli launch. This avoids
# GApplication activation handing the URL to an older window whose bridge may
# belong to another episode.
flatpak kill org.gnome.Showtime >/dev/null 2>&1 || true

rundir="${XDG_RUNTIME_DIR:-/run/user/$UID}/ani-showtime"
mkdir -p "$rundir"

# Persist playback position per logical title so reopening the same episode/movie
# resumes where it was closed. MPRIS gives us the actual Showtime position.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/media-player/resume"
legacy_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/premium-media/resume"
mkdir -p "$state_dir"
state_key="$(printf '%s' "$title" | sha256sum | awk '{print $1}')"
state_file="$state_dir/${state_key}.pos"
legacy_state_file="$legacy_state_dir/${state_key}.pos"
if [[ ! -e "$state_file" && -r "$legacy_state_file" ]]; then
  cp -f "$legacy_state_file" "$state_file" 2>/dev/null || true
fi
resume_us=0
if [[ -r "$state_file" ]]; then
  saved="$(cat "$state_file" 2>/dev/null || true)"
  [[ "$saved" =~ ^[0-9]+$ ]] && resume_us="$saved"
fi

log="$rundir/${port}.log"
python3 "$root/ani-showtime-proxy.py" --video "$video" --subtitle "$subtitle" --referrer "$referrer" --port "$port" >"$log" 2>&1 &
proxy_pid=$!
monitor_pid=""
cleanup(){
  [[ -n "$monitor_pid" ]] && kill "$monitor_pid" 2>/dev/null || true
  kill "$proxy_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM HUP
for _ in $(seq 1 40); do
  if grep -q '^http://' "$log" 2>/dev/null; then break; fi
  kill -0 "$proxy_pid" 2>/dev/null || { cat "$log" >&2; exit 1; }
  sleep .05
done
url="http://127.0.0.1:${port}/master.m3u8"

# Do not open Showtime until the local HLS master is genuinely playable.
# This turns upstream/referrer failures into a clean launcher error instead of
# leaving Showtime on its generic “Unable to play video” screen.
if ! curl -fsS --retry 3 --retry-all-errors --connect-timeout 5 --max-time 20 "$url" >/dev/null; then
  printf 'ani-showtime: stream preflight failed; Showtime was not opened.
' >&2
  exit 1
fi

subtitle_local=""
if [[ -n "$subtitle" ]]; then
  subtitle_local="http://127.0.0.1:${port}/subtitle.vtt"
fi

showtime_log="$rundir/${port}-showtime.log"
flatpak_args=(
  run
  --share=network
  --filesystem="$root:ro"
  --command=python3
)
if [[ -n "$subtitle_local" ]]; then
  flatpak_args+=(--env="MEDIA_PLAYER_SUBTITLE_URI=$subtitle_local")
fi
flatpak "${flatpak_args[@]}" org.gnome.Showtime "$root/showtime-player.py" --new-window "$url" >"$showtime_log" 2>&1 &
showtime_pid=$!

# Wait until this exact local stream is exposed over Showtime's MPRIS service.
for _ in $(seq 1 80); do
  meta="$(busctl --user get-property org.mpris.MediaPlayer2.org.gnome.Showtime /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player Metadata 2>/dev/null || true)"
  [[ "$meta" == *"$url"* ]] && break
  sleep .1
done

# Fullscreen the Showtime window by selector so remote launches do not depend
# on which app happened to own keyboard focus.
if [[ "${ANI_SHOWTIME_FULLSCREEN:-1}" != "0" ]]; then
  for _ in $(seq 1 30); do
    showtime_addr="$(hyprctl -j clients 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); ws=[w for w in d if w.get("class")=="org.gnome.Showtime"]; print(max(ws,key=lambda w:int(w.get("pid",0))).get("address","") if ws else "")' 2>/dev/null || true)"
    if [[ "$showtime_addr" =~ ^0x[0-9a-fA-F]+$ ]]; then
      hyprctl dispatch "hl.dsp.window.fullscreen({window=\"address:$showtime_addr\",mode=\"fullscreen\",action=\"set\"})" >/dev/null 2>&1 || true
      break
    fi
    sleep .1
  done
fi

# Resume relative to the position Showtime already reached while loading.
if (( resume_us > 0 )); then
  current_line="$(busctl --user get-property org.mpris.MediaPlayer2.org.gnome.Showtime /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player Position 2>/dev/null || true)"
  current_us="${current_line##* }"
  [[ "$current_us" =~ ^[0-9]+$ ]] || current_us=0
  delta=$((resume_us-current_us))
  if (( delta != 0 )); then
    busctl --user call org.mpris.MediaPlayer2.org.gnome.Showtime /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player Seek x "$delta" >/dev/null 2>&1 || true
  fi
fi

# Track the real player position every two seconds. Near the end, clear the
# state so a completed video starts from the beginning next time.
(
  while kill -0 "$showtime_pid" 2>/dev/null; do
    pos_line="$(busctl --user get-property org.mpris.MediaPlayer2.org.gnome.Showtime /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player Position 2>/dev/null || true)"
    pos_us="${pos_line##* }"
    meta="$(busctl --user get-property org.mpris.MediaPlayer2.org.gnome.Showtime /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player Metadata 2>/dev/null || true)"
    duration_us="$(printf '%s' "$meta" | sed -n 's/.*"mpris:length" x \([0-9][0-9]*\).*/\1/p')"
    if [[ "$pos_us" =~ ^[0-9]+$ ]]; then
      if [[ "$duration_us" =~ ^[0-9]+$ ]] && (( duration_us > 0 && pos_us >= duration_us-15000000 )); then
        rm -f "$state_file"
      else
        tmp="${state_file}.tmp.$$"
        printf '%s\n' "$pos_us" >"$tmp"
        mv -f "$tmp" "$state_file"
      fi
    fi
    sleep 2
  done
) &
monitor_pid=$!

wait "$showtime_pid" || true
