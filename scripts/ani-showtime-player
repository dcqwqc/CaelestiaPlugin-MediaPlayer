#!/usr/bin/env bash
set -euo pipefail
video="${1:?video URL required}"
referrer="${2:-https://zokoanime.video/}"
subtitle="${3:-}"
title="${4:-Anime}"

# Remote/agent shells may not inherit the graphical session environment.
# Recover it from the running Caelestia shell so Showtime can still launch.
if [[ -z "${WAYLAND_DISPLAY:-}" || -z "${DBUS_SESSION_BUS_ADDRESS:-}" || -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  shell_pid="$(systemctl --user show -p MainPID --value caelestia-shell.service 2>/dev/null || true)"
  if [[ -n "$shell_pid" && "$shell_pid" != "0" && -r "/proc/$shell_pid/environ" ]]; then
    while IFS= read -r -d '' kv; do
      case "$kv" in
        WAYLAND_DISPLAY=*|HYPRLAND_INSTANCE_SIGNATURE=*|DBUS_SESSION_BUS_ADDRESS=*|XDG_RUNTIME_DIR=*) export "$kv" ;;
      esac
    done < "/proc/$shell_pid/environ"
  fi
fi
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$UID}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
root="$(cd -- "$(dirname -- "$script_path")" && pwd)"


# Background episode resolution reuses the already-running Showtime session.
# ani-cli still resolves the provider URL; this wrapper hands the result back
# to the local controller instead of opening/killing another player window.
if [[ -n "${ANI_SHOWTIME_HANDOFF_URL:-}" ]]; then
  payload="$(python3 - "$video" "$referrer" "$subtitle" "$title" <<'PYJSON'
import json, os, sys
print(json.dumps({
    "video": sys.argv[1],
    "referrer": sys.argv[2],
    "subtitle": sys.argv[3],
    "title": sys.argv[4],
    "anime_id": os.environ.get("ANI_SHOWTIME_ANIME_ID", ""),
    "anime_title": os.environ.get("ANI_SHOWTIME_ANIME_TITLE", ""),
    "episode": os.environ.get("ANI_SHOWTIME_EPISODE", ""),
    "episode_list": os.environ.get("ANI_SHOWTIME_EPISODE_LIST", ""),
    "mal_id": os.environ.get("ANI_SHOWTIME_MAL_ID", ""),
    "mode": os.environ.get("ANI_SHOWTIME_MODE", "sub"),
    "quality": os.environ.get("ANI_SHOWTIME_QUALITY", "best"),
    "subtitle_catalog": os.environ.get("ANI_SHOWTIME_SUBTITLE_CATALOG", ""),
}, ensure_ascii=False))
PYJSON
)"
  curl -fsS --connect-timeout 5 --max-time 40 -X POST -H 'Content-Type: application/json' --data-binary "$payload" "$ANI_SHOWTIME_HANDOFF_URL" >/dev/null
  exit 0
fi
port="$(python3 - <<'PY'
import socket
s=socket.socket(); s.bind(('127.0.0.1',0)); print(s.getsockname()[1]); s.close()
PY
)"
# Keep one clean Showtime playback instance per ani-cli launch. This avoids
# GApplication activation handing the URL to an older window whose bridge may
# belong to another episode.
flatpak kill org.gnome.Showtime >/dev/null 2>&1 || true

rundir="${XDG_RUNTIME_DIR:-/run/user/$UID}/ani-showtime"
mkdir -p "$rundir"

log="$rundir/${port}.log"
python3 "$root/ani-showtime-proxy.py" --video "$video" --subtitle "$subtitle" --referrer "$referrer" --port "$port" >"$log" 2>&1 &
proxy_pid=$!
cleanup(){
  # AI subtitle workers are children of the session proxy. Do not leave GPU/CPU
  # generation orphaned after the player/session is closed or restarted.
  pkill -TERM -P "$proxy_pid" 2>/dev/null || true
  kill "$proxy_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM HUP
for _ in $(seq 1 40); do
  if grep -q '^http://' "$log" 2>/dev/null; then break; fi
  kill -0 "$proxy_pid" 2>/dev/null || { cat "$log" >&2; exit 1; }
  sleep .05
done
url="http://127.0.0.1:${port}/master.m3u8"

# Do not open Showtime until the local HLS master is genuinely playable.
# This turns upstream/referrer failures into a clean launcher error instead of
# leaving Showtime on its generic “Unable to play video” screen.
if ! curl -fsS --retry 3 --retry-all-errors --connect-timeout 5 --max-time 20 "$url" >/dev/null; then
  printf 'ani-showtime: stream preflight failed; Showtime was not opened.
' >&2
  exit 1
fi

subtitle_local=""
if [[ -n "$subtitle" ]]; then
  subtitle_local="http://127.0.0.1:${port}/subtitle.vtt"
fi

showtime_log="$rundir/${port}-showtime.log"
flatpak_args=(
  run
  --share=network
  --filesystem="$root:ro"
  --command=python3
  --env="MEDIA_PLAYER_SESSION_URL=http://127.0.0.1:${port}/api/session"
)
if [[ -n "$subtitle_local" ]]; then
  flatpak_args+=(--env="MEDIA_PLAYER_SUBTITLE_URI=$subtitle_local")
fi
flatpak "${flatpak_args[@]}" org.gnome.Showtime "$root/showtime-player.py" --new-window "$url" >"$showtime_log" 2>&1 &
showtime_pid=$!

# Never force compositor-level fullscreen by default. The previous custom
# fullscreen dispatcher could trap global mouse/keyboard input after remote
# launches. Normal-window launch keeps workspace/keybind escape paths intact.
# Fullscreen remains explicitly opt-in with ANI_SHOWTIME_FULLSCREEN=1.
if [[ "${ANI_SHOWTIME_FULLSCREEN:-0}" == "1" ]]; then
  for _ in $(seq 1 30); do
    showtime_addr="$(hyprctl -j clients 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); ws=[w for w in d if w.get("class")=="org.gnome.Showtime"]; print(max(ws,key=lambda w:int(w.get("pid",0))).get("address","") if ws else "")' 2>/dev/null || true)"
    if [[ "$showtime_addr" =~ ^0x[0-9a-fA-F]+$ ]]; then
      hyprctl dispatch focuswindow "address:$showtime_addr" >/dev/null 2>&1 || true
      hyprctl dispatch fullscreen 0 >/dev/null 2>&1 || true
      break
    fi
    sleep .1
  done
fi

wait "$showtime_pid" || true
